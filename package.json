{
  "name": "@kalmwerk/consent-banner",
  "version": "1.0.0",
  "description": "Dependency-free cookie consent banner with Google Consent Mode v2, script blocking and accessible keyboard focus. Works offline: no calls home.",
  "keywords": [
    "cookie-consent",
    "cookie-banner",
    "consent-banner",
    "consent-mode",
    "google-consent-mode-v2",
    "gdpr",
    "eprivacy",
    "cmp",
    "privacy",
    "gtm"
  ],
  "homepage": "https://privacy-pill-consent-studio.lovable.app/open-source",
  "bugs": {
    "url": "https://github.com/kalmwerk/consent-banner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalmwerk/consent-banner.git"
  },
  "license": "MIT",
  "author": "Kalmwerk <kalmwerk@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./consent-banner.min.js": "./dist/consent-banner.min.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "locales": [
        "./dist/locales.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
